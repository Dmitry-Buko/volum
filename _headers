# MIME-типы 3D-моделей: критично для AR Quick Look на iPhone
/assets/models/*.usdz
  Content-Type: model/vnd.usdz+zip
  Cache-Control: public, max-age=31536000, immutable

/assets/models/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=31536000, immutable

# Scene Viewer на Android запрашивает модель с другого origin
/assets/models/*
  Access-Control-Allow-Origin: *

# Долгий кэш для тяжёлых неизменяемых ассетов
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000

/assets/css/*
  Cache-Control: public, max-age=31536000

# Страницы и статики — всегда свежие
/*
  X-Content-Type-Options: nosniff
